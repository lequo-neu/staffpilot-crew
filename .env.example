# Copy to .env or export in your shell. Only the providers you set are used.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Sign in. Users as name:password pairs; a password equal to the name is changed at the first sign in.
# STAFFPILOT_USERS=admin:admin,kevin:kevin,khoa:khoa,hamad:hamad
# STAFFPILOT_LOGIN=0 turns sign in off.

# StaffPilot Crew. STAFFPILOT_OFFLINE=1 hides every key, so nothing is ever sent to a model.
# STAFFPILOT_OFFLINE=1
# Another crew config file (model ids, prices, retry limits); config/crew.toml is read by default.
# STAFFPILOT_CREW_CONFIG=config/crew.toml
# Sign in on the crew pages: required (default), optional (guests may look but not approve) or disabled.
# STAFFPILOT_AUTH_MODE=required
